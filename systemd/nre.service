[Unit]
Description=NREPlatform - Network Resilience Experimentation Platform
Documentation=https://github.com/your-repo/NREPlatform
After=network.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/nre daemon start --target 192.168.1.50 --iface br-lan --interval 60
ExecStop=/usr/local/bin/nre daemon stop
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nre

# Security hardening
NoNewPrivileges=false
ProtectSystem=strict
ReadWritePaths=/var/run/nre /var/log
ProtectHome=true
PrivateTmp=true

# Resource limits
LimitNOFILE=65536
MemoryMax=256M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
