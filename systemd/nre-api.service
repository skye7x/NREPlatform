[Unit]
Description=NREPlatform REST API Server
Documentation=https://github.com/your-repo/NREPlatform
After=network.target nre.service
Wants=nre.service

[Service]
Type=simple
ExecStart=/usr/local/bin/nre api start --port 8080
ExecStop=/usr/local/bin/nre api stop
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nre-api

[Install]
WantedBy=multi-user.target
